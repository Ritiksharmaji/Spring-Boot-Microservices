# Rendered by the nginx image at start-up (envsubst): ${API_DOMAIN}, ${AUTH_DOMAIN}

upstream gateway  { server api-gateway:8080; keepalive 32; }
upstream keycloak { server keycloak:8080; }

# --- HTTP: ACME challenges + redirect to HTTPS ---------------------------------
server {
    listen 80;
    server_name ${API_DOMAIN} ${AUTH_DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# --- API (Spring Cloud Gateway) -------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    include /etc/nginx/conf.d/ssl-params.inc;

    # Internal endpoints are never public (the gateway does not route them either)
    location /internal/ { return 404; }
    location /actuator/ {
        # only health is public; everything else is admin-only at the gateway anyway
        location = /actuator/health { proxy_pass http://gateway; include /etc/nginx/conf.d/proxy-params.inc; }
        return 404;
    }

    location / {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://gateway;
        include /etc/nginx/conf.d/proxy-params.inc;
    }
}

# --- Keycloak (login, tokens, admin console) -------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${AUTH_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    include /etc/nginx/conf.d/ssl-params.inc;

    proxy_buffer_size 128k;
    proxy_buffers 4 256k;

    location / {
        limit_req zone=auth burst=30 nodelay;
        proxy_pass http://keycloak;
        include /etc/nginx/conf.d/proxy-params.inc;
    }
}
