# ------------------------------------------------------------------
# Environment variables for the e-commerce platform.
# Copy to `.env` (never commit it) and change values as needed.
# Every variable has a local-development default, so for a local run
# with the infrastructure on localhost you only need to set the ones
# that differ (e.g. a cloud RabbitMQ or MongoDB Atlas).
# ------------------------------------------------------------------

# --- Spring Cloud infrastructure ---
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_DASHBOARD_URL=http://localhost:8761
# Optional: serve config from a folder instead of the jar (e.g. file:/config/)
# CONFIG_REPO_LOCATION=classpath:/config

# --- PostgreSQL (product-service, order-service, payment-service) ---
# Each service has its own database (defaults: productdb, orderdb, paymentdb);
# set DB_NAME per service only if you need different names.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=embarkx
DB_PASSWORD=change-me
JPA_SHOW_SQL=false

# --- MongoDB (user-service) ---
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/userdb
SPRING_DATA_MONGODB_DATABASE=userdb

# --- RabbitMQ (Spring Cloud Bus + order saga events) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

# --- Payment (simulated provider: orders above this amount are declined) ---
PAYMENT_MAX_AMOUNT=50000.00

# --- Email (notification-service). Leave MAIL_HOST empty to only log notifications.
# Local: Mailpit (SMTP 1025, inbox UI http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@shop.local

# --- Redis (API gateway rate limiter) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Keycloak (OAuth2 / JWT validation at the gateway) ---
KEYCLOAK_ISSUER_URI=http://localhost:8483/realms/ecom-app

# --- Tracing ---
ZIPKIN_URL=http://localhost:9411/api/v2/spans
TRACING_SAMPLING_PROBABILITY=1.0
