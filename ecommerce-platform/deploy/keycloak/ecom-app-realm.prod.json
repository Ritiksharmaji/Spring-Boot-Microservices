{
  "realm": "ecom-app",
  "displayName": "E-Commerce Shop",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Shop: profile, cart, own orders"
      },
      {
        "name": "ADMIN",
        "description": "Manage catalog, users, all orders and payments"
      },
      {
        "name": "default-roles-ecom-app",
        "description": "Default roles for new users",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "CUSTOMER"
          ]
        }
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-ecom-app",
    "description": "Roles every new (self-registered) user gets",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "CUSTOMER"
      ]
    }
  },
  "clients": [
    {
      "clientId": "oauth2-ecom-pkce",
      "name": "E-Commerce web / mobile client",
      "description": "Public client for the shop frontend: Authorization Code + PKCE only",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${FRONTEND_URL}/*"
      ],
      "webOrigins": [
        "${FRONTEND_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FRONTEND_URL}/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "basic"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ]
    }
  ],
  "verifyEmail": false,
  "passwordPolicy": "length(10) and upperCase(1) and lowerCase(1) and digits(1) and notUsername"
}
